{
  "name": "crabsprogramming-desktop",
  "version": "1.0.0",
  "description": "CrabsProgramming Desktop Application",
  "main": "main.js",
  "author": {
    "name": "Xander Gibson",
    "email": "xandergibson2015@gmail.com"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac --x64 --publish=never && electron-builder --mac --arm64 --publish=never",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.crabsprogramming.desktop",
    "productName": "CrabsProgramming Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "CrabsProgramming-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "minimumSystemVersion": "10.13.0",
      "target": [
        "dmg",
        "pkg"
      ],
      "artifactName": "CrabsProgramming-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "CrabsProgramming-${version}-${arch}.${ext}"
    }
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs"
}
